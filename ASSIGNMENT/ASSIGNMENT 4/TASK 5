"""

    with open("attendance.csv", "w", encoding="utf-8") as file:
        file.write(data)

    records = read_attendance("attendance.csv")

    result = calculate_percentage(records)

    absentees = find_three_day_absentees(records)

    write_report(result, absentees)

    print("Attendance Records:", records)
    print("\nAttendance Percentage:")

    for reg, percentage in result.items():
