
import os
import tempfile

class InvalidRecord(Exception):
    """Raised when an attendance record is invalid."""

def parse_line(line):
    parts = line.strip().split(",")

    if len(parts) != 3:
        raise InvalidRecord(
            f"expected 3 fields, found {len(parts)}"
        )

    if parts[2] not in ("P", "A"):
        raise InvalidRecord(
            f"invalid status '{parts[2]}'"
        )

    return tuple(parts)

def summarise(path):
    present, absent, errors = 0, 0, []

    try:
        with open(path, "r", encoding="utf-8") as file:
            for line_no, line in enumerate(file, start=1):
                try:
                    reg_no, date, status = parse_line(line)

                    if status == "P":
                        present += 1
                    else:
                        absent += 1

                except InvalidRecord as e:
                    errors.append((line_no, str(e)))

    except FileNotFoundError:
        print("Error: Attendance file not found.")
    except PermissionError:
        print("Error: Permission denied.")
    except UnicodeDecodeError as e:
        raise RuntimeError("Unable to decode attendance file") from e
    finally:
        print("File processing operation completed.")

    return present, absent, errors

data = (
    "192311001,2026-10-08,P\n"
    "192311002,2026-10-08,A\n"
    "192311003,2026-10-08\n"
    "192311004,2026-10-08,L\n"
)

with tempfile.NamedTemporaryFile(
    "w",
    suffix=".csv",
    delete=False,
    encoding="utf-8"
) as tmp:
    tmp.write(data)
    filename = tmp.name

print(summarise(filename))

os.remove(filename)
