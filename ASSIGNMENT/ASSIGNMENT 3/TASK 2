import copy
import sys
import time

rows, cols = 3, 4

bad = [[0] * cols] * rows
bad[0][1] = 7

# TODO 1
good = [[0 for j in range(cols)] for i in range(rows)]

good[0][1] = 7

print("bad :", bad)
print("good:", good)
print(bad[0] is bad[1], good[0] is good[1])

stops = {
    (13.0827, 80.2707): "Chennai Central",
    (13.0418, 80.2341): "T. Nagar"
}

print(stops[(13.0418, 80.2341)])

# Tuple as dictionary key
try:
    stops[[13.0418, 80.2341]] = "T. Nagar"
except TypeError as e:
    print("Error:", e)

# Aliasing
a = [1, 2, 3]
b = a
b[0] = 100
print("Aliasing:", a, b)

# Shallow copy
original = [[1, 2], [3, 4]]
shallow = copy.copy(original)
shallow[0][0] = 99
print("Original:", original)
print("Shallow:", shallow)

# List slicing copy
sliced = original[:]
print("Sliced:", sliced)

# Deep copy
deep = copy.deepcopy(original)
deep[0][0] = 500
print("Original:", original)
print("Deep:", deep)

# Tuple unpacking
coordinates = [(10, 20), (30, 40), (50, 60)]

for latitude, longitude in coordinates:
    print(latitude, longitude)

# Memory comparison
values = list(range(1000000))
tuple_values = tuple(values)

print("List memory:", sys.getsizeof(values))
print("Tuple memory:", sys.getsizeof(tuple_values))

# Creation time
start = time.time()
a = list(range(1000000))
print("List creation:", time.time() - start)

start = time.time()
b = tuple(range(1000000))
print("Tuple creation:", time.time() - start)

# Indexing time
start = time.time()
for i in range(100000):
    x = a[i]
print("List indexing:", time.time() - start)

start = time.time()
for i in range(100000):
    x = b[i]
print("Tuple indexing:", time.time() - start)

# List inside tuple
data = ([1, 2, 3], 10)
data[0].append(4)
print("Modified tuple:", data)
