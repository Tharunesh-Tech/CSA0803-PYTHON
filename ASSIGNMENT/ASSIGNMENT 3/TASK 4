# Membership testing
for n in [10000, 100000, 1000000]:
    data = list(range(n))
    data_set = set(data)

    start = time.time()
    print(n in data)
    print("List search:", time.time() - start)

    start = time.time()
    print(n in data_set)
    print("Set search:", time.time() - start)

