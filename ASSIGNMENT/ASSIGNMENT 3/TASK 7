# Compare every pair
def pair_comparison(contacts):
    duplicates = []

    for i in range(len(contacts)):
        for j in range(i + 1, len(contacts)):
            number1 = normalize_number(contacts[i].get("phone", ""))
            number2 = normalize_number(contacts[j].get("phone", ""))

            if number1 and number1 == number2:
                duplicates.append((i, j))

    return duplicates

small_contacts = contacts[:1000]

start = time.time()
pair_comparison(small_contacts)
pair_time = time.time() - start

print("Pair comparison time:", pair_time)

